# 선택 사항
HOST_PORT=8010
AI_TRADING_DB_PATH=/app/data/ai-trading.db
AI_TRADING_PORTFOLIO_PATH=/app/data/portfolio.json

# 포트폴리오 예시(JSON 배열). 실제 보유종목을 여러 개 넣을 수 있습니다.
AI_TRADING_PORTFOLIO_JSON=

# KIS 실연동(비밀값은 여기에 두고 YAML에는 넣지 마세요)
KIS_ENABLE_LIVE=0
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_ACCOUNT_NO=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCESS_TOKEN=
KIS_USER_AGENT=Mozilla/5.0

# 기본 인증(외부 노출 방지)
AI_TRADING_BASIC_AUTH_USER=admin
AI_TRADING_BASIC_AUTH_PASSWORD=

AI_TRADING_ENABLE_LIVE_ORDERS=0

AI_TRADING_WATCH_INTERVAL_SECONDS=300

AI_TRADING_WATCH_SYMBOLS=

AI_TRADING_STRATEGY_PROFILE=aggressive

AI_TRADING_AGGRESSIVE_BUY_THRESHOLD=0.20

AI_TRADING_AGGRESSIVE_SELL_THRESHOLD=-0.20

AI_TRADING_AGGRESSIVE_MIN_CONFIDENCE=0.20

AI_TRADING_AGGRESSIVE_STOP_LOSS_PCT=0.035

AI_TRADING_AGGRESSIVE_TAKE_PROFIT_PCT=0.09

AI_TRADING_AGGRESSIVE_MAX_POSITION_VALUE=2000000

AI_TRADING_AGGRESSIVE_POSITION_MULTIPLIER=2.0

AI_TRADING_DEFAULT_HEDGE_SYMBOL=114800.KS

AI_TRADING_HEDGE_RATIO=0.50

AI_TRADING_HEDGE_TRIGGER_PCT=0.03

AI_TRADING_HEDGE_MAP=
